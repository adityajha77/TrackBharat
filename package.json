{
  "name": "trackbharat",
  "private": true,
  "description": "Track Bharat: making political promises measurable and government performance understandable.",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @trackbharat/api --filter @trackbharat/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @trackbharat/api db:generate",
    "db:migrate": "pnpm --filter @trackbharat/api db:migrate",
    "db:seed": "pnpm --filter @trackbharat/api db:seed",
    "db:studio": "pnpm --filter @trackbharat/api db:studio"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
