# Copy to apps/api/.env for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Matches the Postgres service in docker-compose.yml
DATABASE_URL=postgres://trackbharat:trackbharat@localhost:5433/trackbharat

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# How long a cached PIN code lookup is trusted before re-fetching from India Post
PINCODE_CACHE_TTL_DAYS=30
INDIA_POST_BASE_URL=https://api.postalpincode.in

# Admin write endpoints (temporary until Phase 2 auth). Unset = disabled.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# Integration tests (PostGIS) run only when this is set. Use a THROWAWAY database:
#   docker compose exec db createdb -U trackbharat trackbharat_test
#   DATABASE_URL=postgres://trackbharat:trackbharat@localhost:5433/trackbharat_test pnpm db:migrate
# TEST_DATABASE_URL=postgres://trackbharat:trackbharat@localhost:5433/trackbharat_test
