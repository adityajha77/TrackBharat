{
  "name": "@trackbharat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrackBharat REST API (Fastify + Postgres). Serves the web app now and the mobile app later.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:import": "tsx --env-file-if-exists=.env src/imports/run.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "job:weekly-rankings": "tsx --env-file-if-exists=.env src/worker.ts --once",
    "job:news": "tsx --env-file-if-exists=.env src/worker.ts --news",
    "user:role": "tsx --env-file-if-exists=.env src/scripts/set-role.ts",
    "mla:wikipedia": "tsx src/scripts/mla-from-wikipedia.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@trackbharat/shared": "workspace:*",
    "croner": "^11.0.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/shapefile": "^0.6.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
