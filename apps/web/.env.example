# Copy to apps/web/.env.local for local development.

# Where the server-side code reaches the API. NOT exposed to the browser
# (no NEXT_PUBLIC_ prefix), so it can be an internal Docker hostname.
API_URL=http://localhost:4000

# Public site URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (EmailJS). These IDs are designed to be public; leave empty to
# show an email link instead of the form.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
